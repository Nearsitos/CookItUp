    "instructions": [
      {
        "step_number": 1,
        "phase": "prep",
        "text": "Heat the 1000 g soup water in the kettle to boiling, approximately 100°C (212°F) at sea level, while completing the remaining preparation.",
        "structured": {
          "action": "BOIL",
          "temperature": {
            "celsius": 100,
            "fahrenheit": 212
          },
          "duration": null,
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 2,
        "phase": "prep",
        "text": "Finely dice the onion into pieces about 5 mm across.",
        "structured": {
          "action": "DICE",
          "temperature": null,
          "duration": "PT1M",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 3,
        "phase": "prep",
        "text": "Coarsely grate the carrot with the box grater.",
        "structured": {
          "action": "GRATE",
          "temperature": null,
          "duration": "PT1M",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 4,
        "phase": "prep",
        "text": "Rinse the lentils in the bowl with the 600 g cold rinsing water.",
        "structured": {
          "action": "RINSE",
          "temperature": null,
          "duration": "PT30S",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 5,
        "phase": "prep",
        "text": "Drain the lentils through the fine-mesh sieve, discarding the rinsing water.",
        "structured": {
          "action": "DRAIN",
          "temperature": null,
          "duration": "PT30S",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 6,
        "phase": "prep",
        "text": "Cut the lemon into four wedges, removing visible seeds.",
        "structured": {
          "action": "SLICE",
          "temperature": null,
          "duration": "PT1M",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 7,
        "phase": "cook",
        "text": "Sauté the onion and carrot with the olive oil in the large saucepan over medium heat for 4 minutes, stirring with the wooden spoon until softened without browning.",
        "structured": {
          "action": "SAUTÉ",
          "temperature": null,
          "duration": "PT4M",
          "doneness_cues": {
            "visual": "The onion looks translucent at the edges and the carrot has softened.",
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 8,
        "phase": "cook",
        "text": "Stir in the cumin, black pepper, salt, drained lentils and hot soup water.",
        "structured": {
          "action": "STIR",
          "temperature": null,
          "duration": "PT30S",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 9,
        "phase": "cook",
        "text": "Bring the soup to a boil over high heat, approximately 100°C (212°F) at sea level.",
        "structured": {
          "action": "BOIL",
          "temperature": {
            "celsius": 100,
            "fahrenheit": 212
          },
          "duration": "PT1M30S",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 10,
        "phase": "cook",
        "text": "Simmer gently with the lid partly covering the saucepan for 18 minutes, around 95°C (203°F), until the lentils collapse and the carrot is completely tender. Lower the heat if the soup threatens to boil over.",
        "structured": {
          "action": "SIMMER",
          "temperature": {
            "celsius": 95,
            "fahrenheit": 203
          },
          "duration": "PT18M",
          "doneness_cues": {
            "visual": "The lentils lose their shape and the soup becomes cloudy and thick.",
            "tactile": "A lentil pressed with the spoon smears easily without a firm center."
          }
        },
        "tips": [
          "If the lentils still have firm centers, continue simmering until soft; older lentils can exceed the stated cooking time."
        ]
      },
      {
        "step_number": 11,
        "phase": "finish",
        "text": "With the saucepan off the heat, puree the soup using the immersion blender until smooth. Keep the blade head submerged and stop the motor before lifting it to prevent hot splashes.",
        "structured": {
          "action": "PUREE",
          "temperature": null,
          "duration": "PT1M",
          "doneness_cues": {
            "visual": "The soup is uniformly smooth and golden-orange, with no visible vegetable pieces.",
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 12,
        "phase": "finish",
        "text": "Serve in four bowls with a lemon wedge alongside each portion for squeezing into the soup.",
        "structured": {
          "action": "SERVE",
          "temperature": null,
          "duration": "PT1M",
          "doneness_cues": {
            "visual": null,
            "tactile": null
          }
        },
        "tips": []
      }
