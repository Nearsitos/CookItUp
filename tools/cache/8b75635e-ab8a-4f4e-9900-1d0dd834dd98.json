    "troubleshooting": [
      {
        "symptom": "The blended soup feels grainy.",
        "likely_cause": "The lentils have not fully softened, or whole lentils were used instead of split lentils.",
        "prevention": "Use hulled split red lentils and check that they smear easily before blending.",
        "fix": "Continue simmering gently until completely soft, then blend again. This may extend the total time."
      },
      {
        "symptom": "The soup tastes bitter.",
        "likely_cause": "The onion or spices scorched during cooking.",
        "prevention": "Soften the vegetables without browning and add the spices with the water.",
        "fix": "If scorching is localized, transfer the soup without scraping the bottom. A pervasive burnt flavor cannot be fixed."
      }
    ],
    "chef_notes": [
      "Grating the carrot helps it soften within the short lentil cooking time.",
      "Heating the soup water during preparation helps keep the total time within 30 minutes.",
      "Fully softened lentils provide a creamy texture without flour or dairy.",
      "Add lemon at the table so its fresh aroma stays vivid and each serving can be adjusted."
    ],
    "cultural_context": "Mercimek çorbası is a Turkish lentil soup commonly prepared with red lentils and aromatics. Smooth versions pair the lentils with vegetables such as onion and carrot; preparations vary between households. See this [Turkish red lentil soup reference](https://myturkishrecipes.com/turkish-red-lentil-soup-mercimek-corbasi).",
