    "instructions": [
      {
        "step_number": 1,
        "phase": "prep",
        "text": "Place the halved cherry tomatoes, minced garlic, torn basil, extra virgin olive oil, flaky sea salt, and black pepper into a large mixing bowl. Toss well to combine.",
        "structured": {
          "action": "MIX",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 2,
        "phase": "prep",
        "text": "Let the tomato mixture sit at room temperature for at least 15 minutes. This allows the salt to draw out the natural juices of the tomatoes, creating the base of your sauce.",
        "structured": {
          "action": "MARINATE",
          "temperature": null,
          "duration": "PT15M",
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 3,
        "phase": "cook",
        "text": "Bring the water to a rolling boil in a large pot. Add the kosher salt. The water should be heavily salted like the sea.",
        "structured": {
          "action": "BOIL",
          "temperature": {
            "celsius": 100,
            "fahrenheit": 212
          },
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 4,
        "phase": "cook",
        "text": "Add the dried short pasta to the boiling water and cook according to the package instructions until al dente.",
        "structured": {
          "action": "BOIL",
          "temperature": null,
          "duration": "PT11M",
          "doneness_cues": {
            "visual": null,
            "tactile": "Pasta should offer a slight resistance when bitten into"
          }
        },
        "tips": []
      },
      {
        "step_number": 5,
        "phase": "finish",
        "text": "Drain the pasta in a colander, reserving a small splash of the starchy pasta water. Do not rinse the pasta.",
        "structured": {
          "action": "DRAIN",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 6,
        "phase": "assemble",
        "text": "Transfer the hot pasta directly into the large mixing bowl with the marinated tomatoes. Toss vigorously to combine, allowing the warmth of the pasta to release the aromatics of the garlic and basil.",
        "structured": {
          "action": "ASSEMBLE",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 7,
        "phase": "finish",
        "text": "Divide among bowls and garnish with extra fresh basil leaves and a final drizzle of extra virgin olive oil.",
