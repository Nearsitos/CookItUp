    "instructions": [
      {
        "step_number": 1,
        "phase": "prep",
        "text": "Combine the dried basil, chives, mint, and oregano in a small bowl. Stir to mix the herbs evenly.",
        "structured": {
          "action": "MIX",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 2,
        "phase": "cook",
        "text": "Heat the oil in a 10-inch skillet over medium-low heat. Sauté the chopped onion and sliced garlic for 2-4 minutes until they are soft.",
        "structured": {
          "action": "SAUTÉ",
          "temperature": null,
          "duration": "PT4M",
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 3,
        "phase": "cook",
        "text": "Add the roasted red peppers, bay leaf, and red-pepper flakes to the skillet. Season with salt and cook for 2 minutes, stirring until the pepper liquid evaporates.",
        "structured": {
          "action": "ADD",
          "temperature": null,
          "duration": "PT2M",
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 4,
        "phase": "cook",
        "text": "Pour the canned tomatoes and their juices into the skillet. Crush the tomatoes into smaller pieces using a spatula.",
        "structured": {
          "action": "PUREE",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 5,
        "phase": "cook",
        "text": "Add 240ml of water to the pan. Increase the heat to high and bring the liquid to a simmer.",
        "structured": {
          "action": "BOIL",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 6,
        "phase": "cook",
        "text": "Reduce the heat and simmer the sauce for 5 minutes. Stir occasionally until the volume reduces by one-fourth and the sauce thickens.",
        "structured": {
          "action": "REDUCE",
          "temperature": null,
          "duration": "PT5M",
          "doneness_cues": {
            "visual": "Sauce is thickened and reduced to 75% of original volume",
            "tactile": null
          }
        },
        "tips": []
      },
      {
        "step_number": 7,
        "phase": "cook",
        "text": "Remove the bay leaf. Lower the heat to medium-low.",
        "structured": {
          "action": "MEASURE",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 8,
        "phase": "cook",
        "text": "Crack the eggs directly into the sauce, keeping them spaced apart. Cover the skillet with a lid.",
        "structured": {
          "action": "ASSEMBLE",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      },
      {
        "step_number": 9,
        "phase": "cook",
        "text": "Cook for 5-8 minutes. The whites should be fully set while the yolks remain runny.",
        "structured": {
          "action": "POACH",
          "temperature": null,
          "duration": "PT8M",
          "doneness_cues": {
            "visual": "Egg whites are opaque and firm; yolks are still soft",
            "tactile": "Yolks should feel springy but liquid when pressed lightly"
          }
        },
        "tips": []
      },
      {
        "step_number": 10,
        "phase": "finish",
        "text": "Garnish with 2 teaspoons of the prepared herb blend and serve the eggs immediately.",
        "structured": {
          "action": "SERVE",
          "temperature": null,
          "duration": null,
          "doneness_cues": null
        },
        "tips": []
      }
    ],
    "troubleshooting": [
      {
        "symptom": "Egg yolks are hard and overcooked",
        "likely_cause": "The skillet was covered for too long or the heat was too high.",
        "prevention": "Check the eggs at the 5-minute mark and remove from heat as soon as whites are set.",
        "fix": "Cannot be fixed; serve as hard-cooked eggs."
      },
      {
        "symptom": "Sauce is too watery",
        "likely_cause": "The sauce was not reduced enough before adding the eggs.",
        "prevention": "Ensure the sauce has thickened and reduced significantly in step 6.",
        "fix": "Remove eggs carefully and simmer sauce longer, though eggs may overcook."
      }
    ],
    "chef_notes": [
      "For a deeper flavor, roast your own red peppers instead of using jarred. Charring them over an open flame or under a broiler will impart a wonderful smoky depth.",
      "Don't overcrowd the skillet when adding the eggs. This ensures they poach evenly and don't stick together, allowing for perfect individual yolks.",
      "The thickness of your sauce is crucial for poaching. If it's too thin, the eggs might spread too much. If it's too thick, the eggs may not cook through properly. Aim for a consistency that coats the back of a spoon.",
      "Taste and adjust the salt and red-pepper flakes before adding the eggs. The sauce should be well-seasoned as it forms the primary flavor for the dish.",
      "Serve with crusty bread for dipping into the rich sauce and runny yolks – it's an essential part of the experience!"
    ],
    "cultural_context": "This dish draws inspiration from Nigerian flavors, particularly the use of rich, spiced tomato bases common in many West African stews and sauces. While not a traditional dish with a long history, it incorporates elements like roasted peppers and aromatic herbs that are widely appreciated across various cuisines, adapted here for a breakfast setting.",
